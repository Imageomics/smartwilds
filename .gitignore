# This repo only tracks documentation/ from the TheWilds2025 working directory.
# Everything else at the top level is local-only data and should NOT be committed.

# Ignore all top-level entries except the ones we want
/*
!/.gitignore
!/LICENSE
!/README.md
!/documentation/
!/processing_output/

# Within processing_output/, only track experimental_results/ and experimental_resultsv2/.
/processing_output/*
!/processing_output/experimental_results/
!/processing_output/experimental_resultsv2/

# Exclude files too large for GitHub (>50MB). Regenerable from code; team reads
# authoritative copies directly on the shared OSC node.
/processing_output/experimental_results/exp1_cross_modal_arrival_rates/results/timestamps_combined.csv
/processing_output/experimental_results/exp1_cross_modal_arrival_rates/results/timestamps_drone.csv
/processing_output/experimental_resultsv2/exp6_3_case_studies/traces/*.events.csv

# Within documentation/, exclude generated artifacts, logs, model weights,
# and nested git repositories that are versioned separately.
documentation/annotation_pipeline/camera_traps/detection_results
documentation/annotation_pipeline/camera_traps/logs/
documentation/annotation_pipeline/camera_traps/yolov8x.pt
documentation/annotation_pipeline/camera_traps/imageomicsthewilds_cameratraps/
documentation/annotation_pipeline/drones/logs/
documentation/**/__pycache__/
documentation/**/*.pyc

# Junk files anywhere in the repo.
**/.DS_Store
**/__pycache__/
**/*.pyc
