  "detection_models": {
    "camera_traps": {
      "object_detection": {
        "model": "YOLOv8X",
        "weights": "yolov8x.pt",
        "input_resolution": "1280x960 (depends on input image)",
        "confidence_threshold": 0.25,
        "nms_threshold": 0.45
      },
      "species_classification": {
        "model": "BioCLIP",
        "labels": "white-tailed deer, deer, bird, horses, takin",
        "output": "species name + confidence score"
      },
      "depth_estimation": {
        "enabled": true,
        "method": "Bounding box height + horizontal angle estimation",
        "parameters": {
          "hfov_deg": 52,
          "target_height_m": 1.0
        },
        "outputs": ["distance_m", "angle_deg", "animal_lat", "animal_lon"]
      }
    },
    "bioacoustics": {
      "species_classification": {
        "model": "BirdCLIP",
        "input_format": "WAV (48 kHz, 16-bit)",
        "output": "species name + confidence score + frequency/time location",
        "note": "User to confirm BirdCLIP compatibility and preprocessing requirements"
      }
    },
    "drones": {
      "object_detection": {
        "model": "YOLOv11 Large",
        "input_format": "Video frames extracted at regular intervals",
        "confidence_threshold": 0.40,
        "output": "bbox coordinates + detection confidence"
      },
      "species_classification": {
        "model": "BioCLIP",
        "labels": "white-tailed deer, deer, bird, horses, takin",
        "annotation_mode": "Manual review required after automated detection"
      }
    },
    "citizen_science": {
      "species_identification": {
        "method": "Manual curation",
        "required_fields": "species_name, behavior, location_coordinates",
        "annotation_status": "pending user-provided index"
      }
    }
  },

